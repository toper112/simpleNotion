rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    match /notionPages/{pageId} {
      allow read: if request.auth != null && (
        isAdmin() || isAssignedToPage(pageId)
      );
      allow create: if request.auth != null && (
        isAdmin() || request.auth.uid != null
      );
      allow update, delete: if request.auth != null && (
        isAdmin() || isAssignedToPage(pageId)
      );
    }

    match /logs/{logId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && isAdmin();
      allow update, delete: if false;
    }

    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isAssignedToPage(pageId) {
      let page = get(/databases/$(database)/documents/notionPages/$(pageId)).data;
      return page != null && (page.assignedTo == null || page.assignedTo.contains(request.auth.uid));
    }
  }
}
